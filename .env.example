# Copy this file to .env for local runs. Never commit a real .env.
# On Render, set these same values in the dashboard (Environment tab)
# instead of using this file.

# Local default when unset: sqlite:///noel.db in the project folder.
# On Render this is wired automatically from the Blueprint database.
DATABASE_URL=

# Owner dashboard PIN. Default when unset is 1234 — always set a real PIN.
OWNER_PIN=

# Flask session key. Any long random string. Sessions reset if it changes.
SECRET_KEY=

# Fernet key for encrypting driver bank numbers. MUST be set persistently
# BEFORE any driver registers, or stored bank data becomes undecryptable
# after a restart. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Local dev server port. Render sets PORT itself — do not set it there.
PORT=5000
